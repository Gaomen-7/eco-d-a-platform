<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.ecom</groupId>
  <artifactId>ecom-flink</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>eco-a-d-platform :: flink</name>
  <description>Flink 作业工程骨架（P1 作业代码的落点；本骨架零 Java 源码）</description>

  <properties>
    <!-- ADR-0002：补丁锚点 2.2.1（FSR §4 冻结 2.2.x 线，不取 2.3.0） -->
    <flink.version>2.2.1</flink.version>
    <!-- HLD §7.1 D-C：坐标必须写全 5.0.0-2.2，不是裸 5.0.0 -->
    <flink.connector.kafka.version>5.0.0-2.2</flink.connector.kafka.version>
    <!-- 注意 artifactId 带 -2.2 后缀，裸 flink-doris-connector 在 Central 不存在 -->
    <flink.connector.doris.version>26.3.0</flink.connector.doris.version>

    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
  </properties>

  <dependencies>
    <!-- 核心 API：provided（Flink inverted classloading，HLD §3.3.4） -->
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-streaming-java</artifactId>
      <version>${flink.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-clients</artifactId>
      <version>${flink.version}</version>
      <scope>provided</scope>
    </dependency>

    <!--
      ★ Table API / SQL：**provided** —— 理由不是省体积，而是「不许打进去」：
        Flink 镜像自带 table-api / table-runtime / planner-loader，
        把 planner 打进用户 jar 会与镜像内的 planner 冲突（官方 inverted
        classloading 明确要求核心/表运行时用 provided）。HLD §3.3.4。
    -->
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-table-api-java</artifactId>
      <version>${flink.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-table-api-java-bridge</artifactId>
      <version>${flink.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-table-common</artifactId>
      <version>${flink.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- Connector：打进作业 jar（shade） -->
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-connector-kafka</artifactId>
      <version>${flink.connector.kafka.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.doris</groupId>
      <artifactId>flink-doris-connector-2.2</artifactId>
      <version>${flink.connector.doris.version}</version>
    </dependency>

    <!--
      JSON format：**required**（不是 provided）——Kafka 表的 'format' = 'json'
      在运行时由作业 jar 提供；镜像不带 flink-json 工厂时会报
      "Could not find any factory for identifier 'json'"。
    -->
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-json</artifactId>
      <version>${flink.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>${maven.compiler.release}</release>
        </configuration>
      </plugin>

      <!-- shade：HLD §3.3.4 的模板——排 jsr305、排签名文件、不落 dependency-reduced-pom -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <artifactSet>
                <excludes>
                  <!-- 只在编译期需要（JSR-305 注解），不进产物 -->
                  <exclude>com.google.code.findbugs:jsr305</exclude>
                </excludes>
              </artifactSet>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <!-- 否则合并后的 jar 校验签名时报 SecurityException -->
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>

              <!--
                ★★ ServicesResourceTransformer（P1 实机证伪后补，2026-10-21）★★
                **不写这一段，Doris connector 在运行时不可见**，实机报：
                  ValidationException: Could not find any factory for identifier
                  'doris' that implements 'DynamicTableFactory'
                  Available factory identifiers are: blackhole datagen
                  dynamic-kafka filesystem kafka legacy-csv print upsert-kafka

                根因**不是缺依赖**，而是 **shade 对 META-INF/services 的默认行为**：
                Java 的 ServiceLoader 靠 `META-INF/services/<接口全名>` 发现 SPI 实现，
                而多个 jar 合并时同名资源**互相覆盖**——shade 默认只留最后处理的那个。
                实测本 jar 里该文件**只剩 Kafka 的三个工厂**：
                  KafkaDynamicTableFactory / UpsertKafkaDynamicTableFactory /
                  DynamicKafkaTableFactory
                ⇒ Doris 的工厂被静默丢失，且**编译期完全看不出来**（依赖在、类在）。

                `ServicesResourceTransformer` 的职责就是把同名 services 文件**按行合并**
                而不是覆盖。⚠️ 凡打进 jar 的 Flink connector / format 都必须靠它，
                这与「用 TABLESAMPLE 拍字节」无关，是 shaded-jar 的通用必修项。
              -->
              <transformers>
                <transformer
                    implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
