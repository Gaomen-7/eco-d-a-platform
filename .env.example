# .env.example — eco-a-d-platform
#
# 复制为 .env 后使用：  cp .env.example .env
# .env 已在 .gitignore 中（REQ-NF-SEC-02 零密钥入仓）⇒ **不要提交 .env**。
#
# 仅在需要覆盖默认值时填写；compose 已给出合理默认。

# ── Superset（REQ-F-BI-03）────────────────────────────────────────────
# 官方变量名（docker-init.sh 实证）。**必须**设置，否则容器拒绝启动。
# 生成建议：  python -c "import secrets;print(secrets.token_urlsafe(48))"
SUPERSET_SECRET_KEY=

# ── 镜像来源 ──────────────────────────────────────────────────────────
# ★ P0 实测：registry-1.docker.io 在本机**不可达**（manifest inspect 超时），
#   必须走中国镜像站。默认 daocloud；如你有更快的镜像可覆盖此项。
REGISTRY_MIRROR=docker.m.daocloud.io

# ── Doris 镜像 ────────────────────────────────────────────────────────
# ★ P0 实测：官方**没有**可直接拉取的 4.1.5 镜像（版本化标签全部 denied），
#   只有 base-latest 是构建基座（不含可运行 FE/BE）。
#   ⇒ 需先本地构建（下载 apache-doris-4.1.5-bin-x86_64.tar.xz），构建后把
#     镜像名填在这里。P0 阶段 Doris 未启用，暂留空。
DORIS_IMAGE=

# ── Kafka retention（gdd §A.2；官方语义「任一条件先满足即删」）────────
# retention.bytes 官方默认 -1（无上限）⇒ **必须显式设**，否则 2 GB 上限不生效。
KAFKA_RETENTION_MS=604800000
KAFKA_RETENTION_BYTES=2147483648

# ── 生成器（P1）──────────────────────────────────────────────────────
# 用户池规模：UV 与漏斗状态量的基数来源（gdd §1.1）
GEN_USER_POOL=100000
GEN_RATE=200
